FROM ros:humble-ros-base AS base

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Humble ships `rmw_fastrtps_cpp` as the default RMW, which matches the most
# common Humble robot deployments. We do NOT override RMW_IMPLEMENTATION here —
# leaving it unset lets the base image pick its default, which is what we want
# when talking to peers on the same wire format.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates build-essential pkg-config git \
      clang libclang-dev cmake python3-pip python3-colcon-common-extensions \
      ros-humble-std-msgs ros-humble-sensor-msgs \
      ros-humble-geometry-msgs ros-humble-nav-msgs ros-humble-diagnostic-msgs \
      ros-humble-tf2-msgs ros-humble-control-msgs \
      ros-humble-trajectory-msgs ros-humble-lifecycle-msgs \
      ros-humble-rcl-interfaces ros-humble-realsense2-camera-msgs \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain 1.88.0 --profile minimal \
      --component rustfmt --component clippy

WORKDIR /work

# Source ROS env in interactive shells
RUN echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc

CMD ["bash"]
